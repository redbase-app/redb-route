    <Description>Quartz.NET scheduling transport for redb.Route ESB framework. Provides Cron and QuartzTimer components.</Description>
    <PackageTags>esb;messaging;quartz;cron;timer;scheduling;redb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="redb.Route.Tests.Quartz" />
