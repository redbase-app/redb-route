<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\redb.Route\redb.Route.csproj" />
    <ProjectReference Include="..\..\redb.Route.SignalR\redb.Route.SignalR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" />
  </ItemGroup>

  <!-- The connector deliberately does NOT depend on a backplane; the host supplies one through
       ConfigureHubServices. The test plays that host, so the dependency lives here. The package
       ships for net10.0 only, so the backplane suite is a net10.0 one. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- One span capture for the smoke tests: the test root trace keeps parallel test classes out. -->
    <Compile Include="../Shared/SpanCapture.cs" Link="Shared/SpanCapture.cs" />
  </ItemGroup>
</Project>

