<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\redb.Route\redb.Route.csproj" />
    <ProjectReference Include="..\..\redb.Route.Controllers\redb.Route.Controllers.csproj" />
    <ProjectReference Include="..\..\redb.Route.Http\redb.Route.Http.csproj" />
    <ProjectReference Include="..\..\redb.Route.SignalR\redb.Route.SignalR.csproj" />
    <ProjectReference Include="..\..\redb.Route.Grpc\redb.Route.Grpc.csproj" />
    <ProjectReference Include="..\..\redb.Route.Soap\redb.Route.Soap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
  </ItemGroup>

  <!-- The SignalR client major follows the target framework, as in redb.Route.SignalR. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.31" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.20" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/TestPorts.cs" Link="Shared/TestPorts.cs" />
  </ItemGroup>
</Project>

