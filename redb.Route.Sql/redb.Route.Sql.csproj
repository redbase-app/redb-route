    <PackageTags>esb;messaging;sql;database;adonet;polling;redb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>3.3.2</Version>
    <PackageVersion>3.3.2</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="redb.Route.Tests.Sql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\redb.Route\redb.Route.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>