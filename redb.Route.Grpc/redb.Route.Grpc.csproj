<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>redb.Route.Grpc</PackageId>
    <Description>gRPC transport for redb.Route ESB framework. Provides Kestrel-based gRPC consumer (server) and GrpcChannel-based producer (client) with generic binary message exchange.</Description>
    <PackageTags>esb;messaging;grpc;protobuf;rpc;http2;redb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="redb.Route.Tests.Grpc" />
    <InternalsVisibleTo Include="redb.Route.Tests.Controllers" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\redb.Route\redb.Route.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\redb_service.proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>