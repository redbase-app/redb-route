# Values of one environment for the SerialNumbers module, as environment variables of the Tsak worker
# (or the environment section of a compose service). Module settings reach the module through the
# Override layer of its context; secrets never go into SerialNumbers.Core.config.json.
# The debug host keeps local values in SerialNumbers.Worker/appsettings.json.

# The worker's redb database; the module's flat tables live there too
ConnectionStrings__MSSql=Server=sql.example.com;Database=serials;User Id=serials;Password=;TrustServerCertificate=true

# SFTP server of the partners
Tsak__Contexts__serial-numbers__Override__Sftp__Host=sftp.example.com
Tsak__Contexts__serial-numbers__Override__Sftp__Username=serials
Tsak__Contexts__serial-numbers__Override__Sftp__Password=
# A partner with its own password
# Tsak__Contexts__serial-numbers__Override__Sftp__Passwords__acme=

# Password of the hub's AS2 certificate (hub.pfx)
Tsak__Contexts__serial-numbers__Override__As2__CertificatePassword=

# Any other module setting, for example the report schedule
# Tsak__Contexts__serial-numbers__Override__Report__Cron=0 0 7 * * ?
