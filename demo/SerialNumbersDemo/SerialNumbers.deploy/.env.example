# ---------------------------------------------------------------------------------------------------------
# docker-compose.tsak.yml reads these. Copy this file to SerialNumbers.deploy/.env and fill them in.
# ---------------------------------------------------------------------------------------------------------

# HMAC secret of the worker's API keys, at least 16 characters.
TSAK_AUTH_SECRET=
# The dashboard's service key: any random string. The worker stores only its hash.
TSAK_WEB_API_KEY=
# HMAC-SHA256(TSAK_WEB_API_KEY, key = TSAK_AUTH_SECRET), hex, upper case:
#   printf %s "$TSAK_WEB_API_KEY" | openssl dgst -sha256 -hmac "$TSAK_AUTH_SECRET" | awk '{print toupper($NF)}'
#   PowerShell: [Convert]::ToHexString([Security.Cryptography.HMACSHA256]::new([Text.Encoding]::UTF8.GetBytes($secret)).ComputeHash([Text.Encoding]::UTF8.GetBytes($key)))
TSAK_WEB_API_KEY_HASH=
# Password of the dashboard's admin login.
TSAK_WEB_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------------------
# On a real worker: the values of one environment for the SerialNumbers module, as environment variables of
# the Tsak worker. Module settings reach the module through the Override layer of its context; secrets never
# go into SerialNumbers.Core.config.json. The debug host keeps local values in
# SerialNumbers.Worker/appsettings.json.
# ---------------------------------------------------------------------------------------------------------

# The worker's default redb, the one the module works in: its provider must be SQL Server. The worker ships
# sqlite and the connection string alone does not change the provider, so set both lines. The database must
# exist before the first start: redb creates its tables, not the database.
# Tsak__Redb__Provider=mssql
# ConnectionStrings__MSSql=Server=sql.example.com;Database=serials;User Id=serials;Password=;TrustServerCertificate=true
# Writes only the properties that changed instead of rewriting all of them on every save (needs UsePro).
# Tsak__Redb__PropsSaveStrategy=ChangeTracking

# SFTP server of the partners, as the worker reaches it (inside a container network, the service name)
# Tsak__Contexts__serial-numbers__Override__Sftp__Host=sftp.example.com
# Tsak__Contexts__serial-numbers__Override__Sftp__Username=serials
# Tsak__Contexts__serial-numbers__Override__Sftp__Password=
# A partner with its own password
# Tsak__Contexts__serial-numbers__Override__Sftp__Passwords__acme=

# Password of the hub's AS2 certificate (hub.pfx)
# Tsak__Contexts__serial-numbers__Override__As2__CertificatePassword=

# Any other module setting, for example the report schedule
# Tsak__Contexts__serial-numbers__Override__Report__Cron=0 0 7 * * ?
