<Project>

  <!-- Shared settings for every project of the demo. Having this file here also stops MSBuild
       from importing the framework repository's own Directory.Build.props, so the folder can be
       copied out and used as a template as it is. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- One place for the redb package version. -->
    <RedbVersion>4.1.1</RedbVersion>

    <!-- EF Core for the part of the model that stays in an EF Core DbContext. Its SQL Server provider
         must accept the Microsoft.Data.SqlClient version redb.MSSql and the Tsak worker ship (7.0.3):
         EF Core 10.0.12 needs 6.1.6 or later. -->
    <EfCoreVersion>10.0.12</EfCoreVersion>
  </PropertyGroup>

</Project>
