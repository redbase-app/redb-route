# Copy to .env next to docker-compose.tsak.yml. The .env file never goes into a repository.

# ── Tsak ──
TSAK_IMAGE=redb-tsak-stack:4.3.0-net10
# openssl rand -base64 32
TSAK_AUTH_SECRET=
# The dashboard's service key, and its hash: printf %s "$TSAK_WEB_API_KEY" | openssl dgst -sha256 -hmac "$TSAK_AUTH_SECRET" | awk '{print $NF}'
TSAK_WEB_API_KEY=
TSAK_WEB_API_KEY_HASH=
# The BCrypt hash of the dashboard password (login: admin), in single quotes so that its "$" signs are kept as they
# are:  printf %s "the password" | mkpasswd -m bcrypt -R 11 -s      (mkpasswd is in the "whois" package)
TSAK_WEB_ADMIN_PASSWORD_HASH=

# ── The Docker network the test driver's access point is on ──
AS4CT_NETWORK=as4-harmony_as4net

# ── The test driver: its two MSH addresses, its party ids, its certificate in ./keys ──
AS4CT_TESTDRIVER_URL=http://harmony-ap:8080/services/msh
AS4CT_TESTDRIVER_CONTROLLER_URL=http://harmony-ap:8080/services/msh
AS4CT_TESTDRIVER_PARTY=test_driver
AS4CT_TESTDRIVER_CONTROLLER_PARTY=test_driver_sut_controller_domain
AS4CT_TESTDRIVER_CERT_FILE=testdriver.crt

# ── The SUT: its party ids, its key in ./keys ──
AS4CT_SUT_PARTY=system_under_test
AS4CT_CONTROLLER_PARTY=sut_controller_domain
AS4CT_SUT_PFX_FILE=sut.p12
AS4CT_SUT_PFX_PASSWORD=
AS4CT_HOST_NAME=redb.route

# ── The retry profile: the user guide asks for 5 redeliveries, less than 3 minutes apart ──
AS4CT_RETRY_COUNT=5
AS4CT_RETRY_DELAY_SECONDS=20

# ── The dashboard: local by default; an address of the host opens it to that network only ──
TSAK_WEB_BIND=127.0.0.1
TSAK_WEB_PORT=18085

# ── Persistent storage (docker-compose.mssql.yml): a database and a login of the stand's own ──
# COMPOSE_FILE=docker-compose.tsak.yml:docker-compose.mssql.yml
# TSAK_MSSQL_CONNECTION=Server=sqlserver;Database=as4ct;User Id=as4ct;Password=...;TrustServerCertificate=true
# TSAK_DB_NETWORK=the Docker network the SQL Server is on
