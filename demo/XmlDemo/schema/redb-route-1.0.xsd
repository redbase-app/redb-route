<xs:schema targetNamespace="urn:redb:route:1.0" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:r="urn:redb:route:1.0">
  <xs:group name="step">
    <xs:choice>
      <xs:element ref="r:aggregate" />
      <xs:element ref="r:beginRedbTransaction" />
      <xs:element ref="r:beginTransaction" />
      <xs:element ref="r:cache" />
      <xs:element ref="r:choice" />
      <xs:element ref="r:circuitBreaker" />
      <xs:element ref="r:claimCheck" />
      <xs:element ref="r:commitTransaction" />
      <xs:element ref="r:controlBus" />
      <xs:element ref="r:convertBody" />
      <xs:element ref="r:debounce" />
      <xs:element ref="r:delay" />
      <xs:element ref="r:dynamicRouter" />
      <xs:element ref="r:enrich" />
      <xs:element ref="r:exceptionHandled" />
      <xs:element ref="r:filter" />
      <xs:element ref="r:idempotentConsumer" />
      <xs:element ref="r:intercept" />
      <xs:element ref="r:interceptFrom" />
      <xs:element ref="r:interceptSendToEndpoint" />
      <xs:element ref="r:loadBalance" />
      <xs:element ref="r:log" />
      <xs:element ref="r:loop" />
      <xs:element ref="r:marshal" />
      <xs:element ref="r:metered" />
      <xs:element ref="r:multicast" />
      <xs:element ref="r:normalize" />
      <xs:element ref="r:ofType" />
      <xs:element ref="r:onCompletion" />
      <xs:element ref="r:onException" />
      <xs:element ref="r:payload" />
      <xs:element ref="r:pollEnrich" />
      <xs:element ref="r:recipientList" />
      <xs:element ref="r:redbDelete" />
      <xs:element ref="r:redbGet" />
      <xs:element ref="r:redbQuery" />
      <xs:element ref="r:redbSave" />
      <xs:element ref="r:removeBody" />
      <xs:element ref="r:removeHeader" />
      <xs:element ref="r:removeHeaders" />
      <xs:element ref="r:removeProperties" />
      <xs:element ref="r:removeProperty" />
      <xs:element ref="r:replayable" />
      <xs:element ref="r:resequence" />
      <xs:element ref="r:rollbackAll" />
      <xs:element ref="r:rollbackTransaction" />
      <xs:element ref="r:routePolicy" />
      <xs:element ref="r:routingSlip" />
      <xs:element ref="r:saga" />
      <xs:element ref="r:sample" />
      <xs:element ref="r:scatterGather" />
      <xs:element ref="r:setBody" />
      <xs:element ref="r:setHeader" />
      <xs:element ref="r:setHeaders" />
      <xs:element ref="r:setProperty" />
      <xs:element ref="r:sort" />
      <xs:element ref="r:split" />
      <xs:element ref="r:stop" />
      <xs:element ref="r:streamCaching" />
      <xs:element ref="r:threads" />
      <xs:element ref="r:throttle" />
      <xs:element ref="r:throwException" />
      <xs:element ref="r:to" />
      <xs:element ref="r:toD" />
      <xs:element ref="r:traced" />
      <xs:element ref="r:transaction" />
      <xs:element ref="r:transform" />
      <xs:element ref="r:transformJson" />
      <xs:element ref="r:tryCatch" />
      <xs:element ref="r:unmarshal" />
      <xs:element ref="r:validate" />
      <xs:element ref="r:validateJsonSchema" />
      <xs:element ref="r:validateXsd" />
      <xs:element ref="r:wireTap" />
      <xs:element ref="r:xslt" />
    </xs:choice>
  </xs:group>
  <xs:element name="aggregate">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="correlation" use="required" type="xs:string" />
      <xs:attribute name="strategy" use="required" type="xs:string" />
      <xs:attribute name="completion" type="xs:string" />
      <xs:attribute name="completionSize" type="xs:int" />
      <xs:attribute name="completionTimeout" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="beginRedbTransaction">
    <xs:complexType>
      <xs:attribute name="storage" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="beginTransaction">
    <xs:complexType>
      <xs:attribute name="policy">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="default" />
            <xs:enumeration value="requiresNew" />
            <xs:enumeration value="suppress" />
            <xs:enumeration value="mandatory" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="cache">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="key" type="xs:string" />
      <xs:attribute name="keyFromBody" type="xs:boolean" />
      <xs:attribute name="ttl" type="xs:string" />
      <xs:attribute name="sliding" type="xs:string" />
      <xs:attribute name="region" type="xs:string" />
      <xs:attribute name="cacheHeaders" type="xs:boolean" />
      <xs:attribute name="provider">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="memory" />
            <xs:enumeration value="distributed" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="choice">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="when">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:group ref="r:step" />
            </xs:choice>
            <xs:attribute name="expr" type="xs:string" />
            <xs:attribute name="predicate" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:element name="otherwise">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:group ref="r:step" />
            </xs:choice>
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="circuitBreaker">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="fallback">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:group ref="r:step" />
            </xs:choice>
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="failureThreshold" type="xs:int" />
      <xs:attribute name="resetTimeout" type="xs:string" />
      <xs:attribute name="halfOpenMaxCalls" type="xs:int" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="claimCheck">
    <xs:complexType>
      <xs:attribute name="operation" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Set" />
            <xs:enumeration value="Get" />
            <xs:enumeration value="GetAndRemove" />
            <xs:enumeration value="Push" />
            <xs:enumeration value="Pop" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="key" type="xs:string" />
      <xs:attribute name="ttl" type="xs:string" />
      <xs:attribute name="repository" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="commitTransaction">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="controlBus">
    <xs:complexType>
      <xs:attribute name="action" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Start" />
            <xs:enumeration value="Stop" />
            <xs:enumeration value="Suspend" />
            <xs:enumeration value="Resume" />
            <xs:enumeration value="Restart" />
            <xs:enumeration value="Status" />
            <xs:enumeration value="Stats" />
            <xs:enumeration value="Fail" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="routeId" use="required" type="xs:string" />
      <xs:attribute name="async" type="xs:boolean" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="convertBody">
    <xs:complexType>
      <xs:attribute name="type" use="required" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="debounce">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="key" use="required" type="xs:string" />
      <xs:attribute name="quietPeriod" use="required" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="delay">
    <xs:complexType>
      <xs:attribute name="duration" type="xs:string" />
      <xs:attribute name="expr" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="dynamicRouter">
    <xs:complexType>
      <xs:attribute name="expr" use="required" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="enrich">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:any namespace="##targetNamespace" processContents="lax" />
      </xs:choice>
      <xs:attribute name="uri" type="xs:string" />
      <xs:attribute name="strategy" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="exceptionHandled">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="filter">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="expr" type="xs:string" />
      <xs:attribute name="predicate" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="idempotentConsumer">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="key" use="required" type="xs:string" />
      <xs:attribute name="repository" use="required" type="xs:string" />
      <xs:attribute name="skipDuplicate" type="xs:boolean" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="intercept">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="when">
          <xs:complexType>
            <xs:attribute name="expr" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="interceptFrom">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="when">
          <xs:complexType>
            <xs:attribute name="expr" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="uri" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="interceptSendToEndpoint">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="when">
          <xs:complexType>
            <xs:attribute name="expr" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="uri" use="required" type="xs:string" />
      <xs:attribute name="skipSendToOriginalEndpoint" type="xs:boolean" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="loadBalance">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="endpoint">
          <xs:complexType>
            <xs:attribute name="uri" use="required" type="xs:string" />
            <xs:attribute name="weight" type="xs:int" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attribute name="strategy" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="roundRobin" />
            <xs:enumeration value="random" />
            <xs:enumeration value="failover" />
            <xs:enumeration value="sticky" />
            <xs:enumeration value="weighted" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="key" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="log">
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="message">
          <xs:complexType mixed="true">
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:element name="header">
          <xs:complexType>
            <xs:attribute name="name" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:element name="property">
          <xs:complexType>
            <xs:attribute name="name" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attribute name="level">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Trace" />
            <xs:enumeration value="Debug" />
            <xs:enumeration value="Information" />
            <xs:enumeration value="Warning" />
            <xs:enumeration value="Error" />
            <xs:enumeration value="Critical" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="showRouteId" type="xs:boolean" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="loop">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="count" type="xs:int" />
      <xs:attribute name="expr" type="xs:string" />
      <xs:attribute name="while" type="xs:string" />
      <xs:attribute name="copy" type="xs:boolean" />
      <xs:attribute name="shareScope" type="xs:boolean" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="marshal">
    <xs:complexType>
      <xs:attribute name="format" type="xs:string" />
      <xs:attribute name="type" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="metered">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="name" use="required" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="multicast">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="parallel" type="xs:boolean" />
      <xs:attribute name="maxParallelism" type="xs:int" />
      <xs:attribute name="stopOnException" type="xs:boolean" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="normalize">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="when">
          <xs:complexType>
            <xs:attribute name="expr" use="required" type="xs:string" />
            <xs:attribute name="transform" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:element name="whenContentType">
          <xs:complexType>
            <xs:attribute name="type" use="required" type="xs:string" />
            <xs:attribute name="transform" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:element name="otherwise">
          <xs:complexType>
            <xs:attribute name="transform" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="ofType">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:group ref="r:step" />
      </xs:choice>
      <xs:attribute name="type" use="required" type="xs:string" />
      <xs:attribute name="id" type="xs:string" />
      <xs:attribute name="description" type="xs:string" />
      <xs:anyAttribute namespace="##other" processContents="lax" />
    </xs:complexType>
  </xs:element>
  <xs:element name="onCompletion">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="when">
          <xs:complexType>
            <xs:attribute name="expr" use="required" type="xs:string" />
            <xs:attribute name="id" type="xs:string" />
            <xs:attribute name="description" type="xs:string" />
            <xs:anyAttribute namespace="##other" processContents="lax" />
          </xs:complexType>
        </xs:element>
        <xs:group ref="r:step" />
      </xs:choice>
