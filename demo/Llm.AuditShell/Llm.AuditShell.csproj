    <ProjectReference Include=".." Version="4.0.1" />
    <PackageReference Include="redb.Route.Llm.csproj" />
    <ProjectReference Include=".." Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <!-- STEP 1 of 3 to enable REDB-backed audit storage: uncomment these two refs.
