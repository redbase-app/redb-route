<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>redb.Route.Demos.LlmAuditShell</RootNamespace>
    <AssemblyName>redb.Route.Demos.LlmAuditShell</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="redb.Route" />
    <PackageReference Include="redb.Route.Http" />
    <PackageReference Include="redb.Route.Llm" />
    <PackageReference Include="redb.Route.Llm.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- STEP 1 of 3 to enable REDB-backed audit storage: uncomment these two refs.
         (Steps 2 and 3 are in Program.cs — search for "REDB-BACKED AUDIT".)
    <PackageReference Include="redb.Core" />
    <PackageReference Include="redb.SQLite.Pro" />
    -->
  </ItemGroup>

</Project>
