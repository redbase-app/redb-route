<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Console application (exe), single file Program.cs -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SqsRpcDemo</RootNamespace>
  </PropertyGroup>

  <!--
    References the redb.Route + SQS connector packages (redb.Route.Sqs on nuget.org).
  -->
  <ItemGroup>
    <PackageReference Include="redb.Route" Version="4.3.0" />
    <PackageReference Include="redb.Route.Core" Version="4.3.0" />
    <PackageReference Include="redb.Route.Sqs" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

</Project>
