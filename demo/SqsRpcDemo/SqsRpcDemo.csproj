<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Console application (exe), single file Program.cs -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SqsRpcDemo</RootNamespace>
  </PropertyGroup>

  <!--
    References the in-repo redb.Route + SQS connector by project (the connector is not yet
    published to NuGet). In a real app you would add the package instead:
        dotnet add package redb.Route.Sqs
  -->
  <ItemGroup>
    <PackageReference Include="redb.Route.csproj" />
    <ProjectReference Include=".." Version="3.3.3" />
    <PackageReference Include="redb.Route.Sqs" Version="3.3.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

</Project>

