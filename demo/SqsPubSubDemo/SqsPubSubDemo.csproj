<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Console application (exe), single file Program.cs -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SqsPubSubDemo</RootNamespace>
  </PropertyGroup>

  <!--
    References the in-repo redb.Route + SQS connector by project (the connector is published as
    redb.Route.Sqs). AWSSDK.SQS arrives transitively via the connector — used here only to create
    the queues up front and read their ARNs for the SNS subscription.
  -->
  <ItemGroup>
    <PackageReference Include="redb.Route.csproj" />
    <ProjectReference Include=".." Version="3.7.2" />
    <PackageReference Include="redb.Route.Sqs" Version="3.7.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

</Project>

