<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>redb.Route.Demos.LlmHttpShell</RootNamespace>
    <AssemblyName>redb.Route.Demos.LlmHttpShell</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="redb.Route" Version="3.1.0" />
    <PackageReference Include="redb.Route.Http" Version="3.1.0" />
    <PackageReference Include="redb.Route.Llm" Version="3.1.0" />
    <PackageReference Include="redb.Route.Llm.Abstractions" Version="3.1.0" />
    <PackageReference Include="redb.Route.Exec" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <!-- Uncomment to enable REDB-backed conversation memory (Postgres):
    <PackageReference Include="redb.Core" Version="	3.0.0" />
    <PackageReference Include="redb.Postgres" Version="	3.0.0" />
    -->
  </ItemGroup>

</Project>
