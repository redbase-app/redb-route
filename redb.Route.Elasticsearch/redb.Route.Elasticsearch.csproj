<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>redb.Route.Elasticsearch</PackageId>
    <Description>Elasticsearch connector for redb.Route ESB framework. Polling search/scroll consumer with deep pagination, source filtering, and delete-after-read; multi-operation producer with Index, Bulk, Search, Get, Update, Delete, Count, and Exists. Compatible with Elasticsearch 8.x.</Description>
    <PackageTags>esb;messaging;elasticsearch;search;redb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="redb.Route.Tests.Elasticsearch" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\redb.Route\redb.Route.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.19.10" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>